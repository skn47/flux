# Virtual environment
.venv/

# Event store (local SQLite data, not source-controlled)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# Internal research/planning docs
progress/
knowledge/

# Runtime logs.
logs/

# Claude Code project tooling (agent defs, local permission settings) --
# internal to how this project was built, not the shipped product.
.claude/

# Generated artifacts (model checkpoints, backtest results) -- regenerated by
# scripts/refresh_pipeline.sh / scripts/refresh_backtests.sh. A fresh clone
# reproduces these by running the pipeline (see api/README.md's "Data
# freshness" section); this repo's own deployment reads them from the host
# filesystem via Docker volumes, never from git (see docker-compose.yml).
# backtest/ (root) is pure generated output post-src/-restructure -- the code
# that produces it now lives in src/backtest/, tracked normally.
lstm/models/
backtest/

# Standalone NLP event classifier checkpoint (src/nlp_classifier/train.py
# reproduces it) -- not wired into the live labeling pipeline, same
# generated-artifact reasoning as lstm/models/ above.
nlp_classifier/checkpoints/

# Runtime status file written by src/ingestion/scheduler.py while it runs --
# transient state, not source, same category as logs/.
ingestion/scheduler_status.json
