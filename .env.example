# Copy this file to `.env` and fill in real values. `.env` itself is
# git-ignored -- never commit real secrets.

# NewsAPI (https://newsapi.org/) API key. If unset, ingestion/run_ingest.py
# logs a one-line warning and skips the NewsAPI connector entirely -- GDELT
# and RSS do not require this.
NEWSAPI_KEY=

# Anthropic API key (https://console.anthropic.com/), used only by
# labeling/llm_labeler.py. If unset, labeling/run_label.py logs a one-line
# warning and skips the LLM-assisted labeler entirely -- the gdelt_derived
# and rule_based labelers do not require this.
ANTHROPIC_API_KEY=

# Phase H API config (api/config.py). All optional -- sensible defaults
# apply if unset (see api/README.md).
API_DB_PATH=
API_HOST=
API_PORT=
# Comma-separated list of allowed frontend origins. Defaults to both Vite
# dev-server origins (localhost and 127.0.0.1 -- different origins under
# same-origin policy even though they resolve to the same host).
API_CORS_ORIGINS=
